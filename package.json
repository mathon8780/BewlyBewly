{
  "name": "bewly-bewly",
  "displayName": "BewlyBewly",
  "type": "module",
  "version": "0.41.2",
  "private": true,
  "packageManager": "pnpm@9.5.0",
  "description": "Just make a few small changes to your Bilibili homepage.",
  "homepage": "https://github.com/hakadao/BewlyBewly",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run clear && cross-env NODE_ENV=development run-p dev:*",
    "dev-firefox": "npm run clear-firefox && cross-env NODE_ENV=development FIREFOX=true run-p dev:*",
    "dev:prepare": "esno scripts/prepare.ts",
    "dev:web": "vite",
    "dev:js": "npm run build:js -- --mode development",
    "dev:bg": "tsup --watch ./src",
    "build": "cross-env NODE_ENV=production run-s clear build:prepare build:js build:bg",
    "build-safari": "cross-env NODE_ENV=production SAFARI=true run-s clear-safari build:prepare build:js build:bg",
    "build-firefox": "cross-env NODE_ENV=production FIREFOX=true run-s clear-firefox build:prepare build:js build:bg",
    "build:prepare": "esno scripts/prepare.ts",
    "build:web": "vite build",
    "build:js": "vite build --config vite.config.content.ts",
    "build:bg": "tsup",
    "convert-safari": "xcrun safari-web-extension-converter ./extension-safari --project-location ./extension-safari-macos --macos-only",
    "pack": "cross-env NODE_ENV=production run-p pack:*",
    "pack:zip": "rimraf extension.zip && jszip-cli add extension/* -o ./extension.zip",
    "pack:zip-firefox": "rimraf extension-firefox.zip && jszip-cli add extension-firefox/* -o ./extension-firefox.zip",
    "pack:zip-safari": "rimraf extension-safari.zip && jszip-cli add extension-safari/* -o ./extension-safari.zip",
    "pack:zip-firefox-sources": "esno scripts/archive-source.ts",
    "pack:crx": "crx pack extension -o ./extension.crx",
    "pack:xpi": "cross-env WEB_EXT_ARTIFACTS_DIR=./ FIREFOX=true web-ext build --source-dir ./extension-firefox --filename extension.xpi --overwrite-dest",
    "start:chromium": "web-ext run --source-dir ./extension --target=chromium",
    "start:firefox": "web-ext run --source-dir ./extension-firefox --target=firefox-desktop",
    "clear": "rimraf extension",
    "clear-firefox": "rimraf extension-firefox",
    "clear-safari": "rimraf extension-safari",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "typecheck": "vue-tsc",
    "postinstall": "npx simple-git-hooks",
    "knip": "knip",
    "submit": "run-p submit:*",
    "submit:chrome": "pnpm wxt submit --chrome-zip ./extension.zip",
    "submit:firefox": "pnpm wxt submit --firefox-zip ./extension-firefox.zip --firefox-sources-zip ./extension-firefox-sources.zip"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "md5": "^2.3.0",
    "mitt": "^3.0.1",
    "overlayscrollbars": "2.7.3",
    "overlayscrollbars-vue": "^0.5.9",
    "pinia": "^2.1.7",
    "qrcode.vue": "^3.4.1",
    "vue-i18n": "^11.4.16",
    "vue-toastification": "2.0.0-rc.5",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.16.0",
    "@ffflorian/jszip-cli": "^3.16.15",
    "@iconify/json": "^2.2.219",
    "@iconify/vue": "^4.1.2",
    "@intlify/unplugin-vue-i18n": "^11.2.7",
    "@rollup/plugin-replace": "^5.0.7",
    "@types/fs-extra": "^11.0.4",
    "@types/md5": "^2.3.6",
    "@types/node": "^24.19.2",
    "@types/webextension-polyfill": "^0.12.6",
    "@unocss/preset-attributify": "^66.11.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vueuse/core": "^10.11.0",
    "@vueuse/integrations": "^10.11.1",
    "chokidar": "^3.6.0",
    "cross-env": "^7.0.3",
    "crx": "^5.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-format": "^0.1.2",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "esno": "^4.7.0",
    "focus-trap": "^7.8.0",
    "fs-extra": "^11.2.0",
    "jsdom": "^24.1.0",
    "knip": "^6.43.0",
    "kolorist": "^1.8.0",
    "lint-staged": "^15.2.7",
    "npm-run-all": "^4.1.5",
    "release-it": "^21.1.1",
    "rimraf": "^5.0.7",
    "sass": "^1.77.5",
    "simple-git-hooks": "^2.11.1",
    "terser": "^5.31.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "unocss": "66.11.0",
    "unplugin-auto-import": "^0.17.6",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue": "^3.5.44",
    "vue-tsc": "^3.1.8",
    "web-ext": "^10.8.0",
    "webextension-polyfill": "^0.12.0",
    "wxt": "^0.21.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "webExt": {
    "run": {
      "keepProfileChanges": true,
      "firefoxProfile": "./web-ext-profile",
      "chromiumProfile": "./web-ext-profile",
      "startUrl": [
        "https://www.bilibili.com/"
      ]
    }
  }
}
