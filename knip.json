{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/contentScripts/index.ts",
    "src/options/main.ts",
    "src/popup/main.ts",
    "scripts/*.ts",
    "*.config.*"
  ],
  "ignore": [
    "src/inject/**",
    "src/components/Settings/BIlibiliSettings/**"
  ],
  "ignoreDependencies": [
    "@iconify/json",
    "uno.css"
  ],
  "rules": {
    "types": "off",
    "enumMembers": "off",
    "exports": "off"
  }
}
